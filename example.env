# Adapter's own PostgreSQL database (never the core's).
NN_ACCOUNT_DATABASE_URL=postgres://nn_account:secret@localhost:5432/nn_account

# Account core internal gRPC address + shared credential (>=32 bytes).
NN_ACCOUNT_CORE_ADDR=localhost:7000
NN_ACCOUNT_CORE_KEY=change-me-core-internal-key-change-me-internal!

# Key consumers (e.g. nn-friends) present as X-API-Key on adapter gRPC.
NN_ACCOUNT_GRPC_API_KEY=change-me-adapter-grpc-key-change-me!

# Listen addresses.
NN_ACCOUNT_GRPC_ADDR=:7001
NN_ACCOUNT_HTTP_ADDR=:8001

# Public hostnames (console DNS redirection targets).
NN_ACCOUNT_NNAS_DOMAIN=account.openpak.example
NN_ACCOUNT_NASC_DOMAIN=nasc.openpak.example
NN_ACCOUNT_CDN_BASE_URL=https://cdn.openpak.example

# Optional comma-separated hostname allowlist; empty allows all (dev only).
NN_ACCOUNT_ALLOWED_HOSTNAMES=

# development | production
NN_ACCOUNT_ENVIRONMENT=production

# /internal/* surface for the website (emulator identities). Empty disables it.
NN_ACCOUNT_INTERNAL_KEY=change-me-internal-key
